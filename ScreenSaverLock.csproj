<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenSaverLock</AssemblyName>
    <RootNamespace>ScreenSaverLock</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="backup\**" />
    <EmbeddedResource Remove="backup\**" />
    <None Remove="backup\**" />
  </ItemGroup>

  <!-- 폼 파일 — 디자이너 활성화 -->
  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="LockForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="LockForm.Designer.cs">
      <DependentUpon>LockForm.cs</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <EmbeddedResource Update="LockForm.resx">
      <DependentUpon>LockForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="ControlForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ControlForm.Designer.cs">
      <DependentUpon>ControlForm.cs</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <EmbeddedResource Update="ControlForm.resx">
      <DependentUpon>ControlForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Release 빌드: 단일 파일 게시, pdb 미생성 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>bin\Release\Publish</PublishDir>
  </PropertyGroup>

  <!-- Release 빌드 완료 후 자동 게시 -->
  <Target Name="AutoPublish" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(IsPublishing)' != 'true'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFile)&quot; -c Release -o &quot;$(MSBuildProjectDirectory)\bin\Release\Publish&quot; -p:PublishSingleFile=true -p:SelfContained=false -p:DebugType=None -p:IsPublishing=true" />
  </Target>

</Project>
